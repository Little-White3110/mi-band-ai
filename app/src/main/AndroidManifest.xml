<?xml version="1.0" encoding="utf-8"?>
<!-- 环上LLM —— LSPosed 模块（Modern Xposed API 102） -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 模块 App 进程（设置页）需要网络权限以执行「测试连接」 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-sdk tools:overrideLibrary="top.yukonga.miuix.kmp.blur" />

    <application
        android:label="环上LLM"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <!-- Xposed 模块声明（LSPosed 管理器识别模块的依据） -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposedminversion"
            android:value="102" />
        <meta-data
            android:name="xposeddescription"
            android:value="环上LLM" />

        <!-- 设置页入口（Miuix / Compose） -->
        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="环上LLM"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 跨进程统计接收通道：Hook 进程（com.mi.health）经 ContentResolver 推送统计到此 -->
        <provider
            android:name=".config.StatsContentProvider"
            android:authorities="llm.miband.littlewhite.stats"
            android:exported="true" />

    </application>

</manifest>
